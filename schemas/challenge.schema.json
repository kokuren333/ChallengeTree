{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://challenge-tree.local/schemas/challenge.schema.json",
  "title": "Challenge Tree Challenge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "nodeId",
    "promptStyle",
    "difficulty",
    "prompt",
    "expectedConcepts",
    "modelAnswer",
    "rubric",
    "commonMisconceptions",
    "resourceIds",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "promptStyle": {
      "type": "string",
      "enum": [
        "definition",
        "why",
        "mechanism",
        "compare",
        "scenario",
        "critique",
        "synthesis"
      ]
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "expectedConcepts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "modelAnswer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30000
    },
    "explanation": {
      "type": "string",
      "maxLength": 30000
    },
    "rubric": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "required"],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "required": { "type": "boolean" }
        }
      }
    },
    "commonMisconceptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "resourceIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "type": "string",
      "enum": ["explain", "short_answer", "true_false"]
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prompt", "modelAnswer", "expectedConcepts", "explanation"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "modelAnswer": { "type": "string", "minLength": 1 },
          "expectedConcepts": { "type": "array", "items": { "type": "string" } },
          "explanation": { "type": "string" }
        }
      }
    }
  }
}
