{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://challenge-tree.local/schemas/tree.schema.json",
  "title": "Challenge Tree Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["rootNodeId", "nodes", "edges"],
  "properties": {
    "rootNodeId": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "https://challenge-tree.local/schemas/node.schema.json"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "type"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": ["dependency", "recommended", "related"]
          }
        }
      }
    }
  }
}
